{
  "name": "evm-flatlogs",
  "version": "0.1.2",
  "description": "EVM Ethereum event log scraper and decoder. Bounded, flat-fee eth_getLogs scanning with ABI event decoding, webhook delivery, continuous streaming, and no CU explosion.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": "./dist/cli.js"
  },
  "bin": {
    "evm-flatlogs": "dist/cli.js",
    "evm-flatlogs-calc": "dist/calc-cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikhailk921/evm-flatlogs.git"
  },
  "homepage": "https://github.com/mikhailk921/evm-flatlogs#readme",
  "bugs": {
    "url": "https://github.com/mikhailk921/evm-flatlogs/issues"
  },
  "keywords": [
    "ethereum",
    "evm",
    "eth_getlogs",
    "logs",
    "event-logs",
    "event-log",
    "events",
    "web3",
    "rpc",
    "indexer",
    "blockchain",
    "scanner",
    "stream",
    "streaming",
    "webhook",
    "abi",
    "abi-decoder",
    "decoder",
    "transfer",
    "erc20"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.19.43",
    "dotenv": "^18.0.9",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0"
  }
}
